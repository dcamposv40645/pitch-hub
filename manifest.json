{
  "manifest_version": 3,
  "name": "Pitch Hub",
  "version": "0.1.0",
  "description": "Real-time pitch detection for audio playing in any tab",
  "permissions": ["tabCapture", "offscreen", "activeTab", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  }
}
